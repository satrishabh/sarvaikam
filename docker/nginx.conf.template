# Full nginx config for the all-in-one image. Rendered to /tmp/runtime/nginx.conf by /entrypoint.sh
# (placeholders: __PORT__, __ENV_HEADERS__). Runs as a non-root user: every writable path is under /tmp.
worker_processes auto;
pid /tmp/runtime/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;
    sendfile      on;
    server_tokens off;
    gzip          on;
    gzip_types    text/css application/javascript application/json image/svg+xml;

    client_body_temp_path /tmp/runtime/client_body;
    proxy_temp_path       /tmp/runtime/proxy;
    fastcgi_temp_path     /tmp/runtime/fastcgi;
    uwsgi_temp_path       /tmp/runtime/uwsgi;
    scgi_temp_path        /tmp/runtime/scgi;

    server {
        listen __PORT__;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;
        client_max_body_size 5m;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
__ENV_HEADERS__

        # Liveness: the gateway process is up (supervisord restarts any crashed backend).
        location = /health { access_log off; default_type text/plain; return 200 "ok\n"; }
        # Readiness: database + all three backends reachable (aggregated by progress-service).
        location = /ready  { access_log off; proxy_pass http://127.0.0.1:8083/api/progress/ready; }
        # Runtime config for the SPA (environment name), generated at container start.
        location = /config.json { alias /tmp/runtime/config.json; add_header Cache-Control no-store; }

        location /api/content/  { proxy_pass http://127.0.0.1:8081; include /etc/sarvaikam/proxy_headers; }
        location /api/auth/     { proxy_pass http://127.0.0.1:8082; include /etc/sarvaikam/proxy_headers; }
        location /api/progress/ { proxy_pass http://127.0.0.1:8083; include /etc/sarvaikam/proxy_headers; }
        # Actuator details are internal only.
        location /api/content/actuator/ { return 404; }

        location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
